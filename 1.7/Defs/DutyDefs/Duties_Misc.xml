<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <DutyDef>
        <defName>VFEE_MoveTo</defName>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="JobGiver_AIFollowEscortee" />
                <li Class="JobGiver_WanderNearDutyLocation" />
            </subNodes>
        </thinkNode>
    </DutyDef>
    <DutyDef>
        <defName>VFEE_AttackEnemySpecifc</defName>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="JobGiver_TakeCombatEnhancingDrug" />
                <li Class="ThinkNode_Subtree" MayRequire="Ludeon.RimWorld.Biotech">
                    <treeDef>Abilities_Aggressive</treeDef>
                </li>
                <li Class="VFEEmpire.JobGiver_AIFightEnemySpecific" />
            </subNodes>
        </thinkNode>
    </DutyDef>
    <DutyDef>
        <defName>VFEE_AssassinApproach</defName>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="VFEEmpire.JobGiver_AssassinApproach" />
                <li Class="JobGiver_Idle">
                    <ticks>60</ticks>
                </li>
            </subNodes>
        </thinkNode>
    </DutyDef>
    <DutyDef>
        <defName>VFEE_AssassinStrike</defName>
        <alwaysShowWeapon>true</alwaysShowWeapon>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="JobGiver_TakeCombatEnhancingDrug" />
                <li Class="VFEEmpire.JobGiver_AssassinStrike" />
                <li Class="JobGiver_AISapper">
                    <canMineMineables>true</canMineMineables>
                    <canMineNonMineables>true</canMineNonMineables>
                </li>
                <li Class="JobGiver_Idle">
                    <ticks>60</ticks>
                </li>
            </subNodes>
        </thinkNode>
        <!-- A smuggled EMP grenade goes the moment a blast would catch what guards her, whatever the deserter is doing -->
        <constantThinkNode Class="VFEEmpire.JobGiver_AssassinThrow" />
    </DutyDef>
    <DutyDef>
        <defName>VFEE_KillRoyalty</defName>
        <alwaysShowWeapon>true</alwaysShowWeapon>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="JobGiver_TakeCombatEnhancingDrug" />
                <li Class="VFEEmpire.JobGiver_AIFightRoyalty" />
            </subNodes>
        </thinkNode>
        <constantThinkNode Class="ThinkNode_ConditionalCanPickupOpportunisticWeapon">
            <subNodes>
                <!-- Try to pick up nearby weapons -->
                <li Class="JobGiver_PickUpOpportunisticWeapon" />
            </subNodes>
        </constantThinkNode>
    </DutyDef>
</Defs>