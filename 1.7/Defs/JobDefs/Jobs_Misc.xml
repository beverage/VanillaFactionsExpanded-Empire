<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <JobDef>
        <defName>VFEE_DefuseBomb</defName>
        <driverClass>VFEEmpire.JobDriver_DefuseBomb</driverClass>
        <reportString>defusing TargetA.</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
    <JobDef>
        <defName>VFEE_PlaceBomb</defName>
        <driverClass>VFEEmpire.JobDriver_PlaceBomb</driverClass>
        <reportString>placing bomb</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
    <JobDef>
        <defName>VFEE_PoisonMeal</defName>
        <driverClass>VFEEmpire.JobDriver_PoisonMeal</driverClass>
        <reportString>poisoning TargetA</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
    <JobDef>
        <defName>VFEE_DiscardMeal</defName>
        <driverClass>VFEEmpire.JobDriver_DiscardMeal</driverClass>
        <reportString>discarding TargetA</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
    <!-- The Brutus closing in on the one it strikes first: it reads as vanilla's FollowClose does -->
    <JobDef>
        <defName>VFEE_ConspiratorCloseIn</defName>
        <driverClass>VFEEmpire.JobDriver_ConspiratorCloseIn</driverClass>
        <reportString>following TargetA.</reportString>
    </JobDef>
    <!-- An attacker making sure of a downed stellarch the Deathless gene keeps alive, with vanilla's execution cut -->
    <JobDef>
        <defName>VFEE_ExecuteStellarch</defName>
        <driverClass>VFEEmpire.JobDriver_ExecuteStellarch</driverClass>
        <reportString>executing TargetA.</reportString>
        <casualInterruptible>false</casualInterruptible>
    </JobDef>
</Defs>