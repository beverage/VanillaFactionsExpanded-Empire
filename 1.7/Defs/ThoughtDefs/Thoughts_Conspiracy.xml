<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- A truce after the Brutus kills the stellarch: colonists who loved her are sorry, those who despised her are glad -->
  <ThoughtDef>
    <defName>VFEE_StellarchTruce</defName>
    <durationDays>60</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>truce with the stellarch's killers</label>
        <description>Our stellarch was murdered, and the killers walk among us.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>sic semper tyrannis</label>
        <description>The stellarch is dead, and I am not sorry.</description>
        <baseMoodEffect>10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- After a failed plot, while a plotter lives in the colony (a year at most): the stellarch, and colonists at 20 or more opinion of her -->
  <ThoughtDef>
    <defName>VFEE_TraitorsAmongUs</defName>
    <workerClass>VFEEmpire.ThoughtWorker_TraitorsAmongUs</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>traitors among us</label>
        <description>Those who plotted against our stellarch still live among us.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
      <li>
        <label>my would-be killers among us</label>
        <description>Those who plotted to kill me still live in this colony.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- After a truce, for as long as the Brutus stays in the colony, whatever the Brutus's rank; a year at most on Normal -->
  <ThoughtDef>
    <defName>VFEE_StellarchsKiller</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>VFEEmpire.ThoughtWorker_StellarchsKiller</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>betrayed the stellarch</label>
        <baseOpinionOffset>-20</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
