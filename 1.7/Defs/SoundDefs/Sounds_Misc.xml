<?xml version="1.0" encoding="UTF-8"?>
<Defs>
    <SoundDef>
        <defName>VFEE_BombBeep</defName>
        <context>MapOnly</context>
        <priorityMode>PrioritizeNearest</priorityMode>
        <subSounds>
          <li>
            <grains>
              <li Class="AudioGrain_Clip">
                <clipPath>Bomb/BombBeep</clipPath>
